# === Production template – niemals echte Secrets committen ===
STEINBACH_PRODUCTION=1
STEINBACH_DEMO_SEED=0
STEINBACH_DEV_SHOW_TOKENS=0
STEINBACH_COOKIE_SECURE=1
STEINBACH_SESSION_HOURS=12
STEINBACH_PUBLIC_BASE_URL=https://portal.example.de
STEINBACH_DB_PATH=/app/data/steinbach.db

# SMTP
STEINBACH_SMTP_HOST=smtp.example.de
STEINBACH_SMTP_PORT=587
STEINBACH_SMTP_USER=
STEINBACH_SMTP_PASSWORD=
STEINBACH_SMTP_FROM=info@immobilienservice-steinbach.de
STEINBACH_SMTP_TLS=1

# Web Push (VAPID)
STEINBACH_VAPID_PUBLIC_KEY=
STEINBACH_VAPID_PRIVATE_KEY=
STEINBACH_VAPID_SUBJECT=mailto:info@immobilienservice-steinbach.de
